#!/bin/sh

. /lib/functions.sh
. /usr/share/libubox/jshn.sh

TAG='mt3600be-toggle'

# 段名必须能在 uci 里直接引用：匿名段（@wifi-iface[0]）跳过，
# 否则快照里会写进一个脚本没法稳定还原的名字。
sec_safe() {
	case "$1" in
		''|*'@'*|*'['*|*']'*|*'='*|*[!A-Za-z0-9_]*) return 1;;
	esac
	return 0
}

snapshot_radio() {
	local section="$1" disabled
	sec_safe "$section" || return 0
	config_get disabled "$section" disabled '0'
	case "$disabled" in 1) disabled=1;; *) disabled=0;; esac
	uci -q add_list "mt3600be-toggle.wifi_state.radio=${section}=${disabled}"
}

# Wi-Fi 档现在可以只关某几个网络（wifi-iface），所以快照也要覆盖 SSID 层。
snapshot_iface() {
	local section="$1" disabled
	sec_safe "$section" || return 0
	config_get disabled "$section" disabled '0'
	case "$disabled" in 1) disabled=1;; *) disabled=0;; esac
	uci -q add_list "mt3600be-toggle.wifi_state.iface=${section}=${disabled}"
}

disable_radio() {
	uci -q set "wireless.${1}.disabled=1"
}

# 作用范围：空 = 总控（全部射频）；否则是 mt3600be-toggle.main.wifi_targets 里的段名。
# 必须在 config_load wireless 之前取，否则会互相覆盖。
wifi_target_list() {
	config_load mt3600be-toggle
	config_list_foreach main wifi_targets emit_target 2>/dev/null
}

emit_target() {
	sec_safe "$1" || return 0
	printf '%s\n' "$1"
}

wifi_reload() {
	uci -q commit wireless
	wifi reload >/dev/null 2>&1
}

# 校验每个 wifi-device 的 vif 是否真的处于 UP（与 mt3600be-reset-control 同源）。
# mtwifi 驱动的并发 setup 竞争可能让 reload 后只剩一半 radio 被初始化。
wifi_all_vifs_up() {
	local keys d n i u iname bad=0
	json_cleanup >/dev/null 2>&1
	json_load "$(ubus call network.wireless status 2>/dev/null)" || return 1
	json_get_keys keys || return 1
	[ -n "$keys" ] || return 1
	for d in $keys; do
		json_select "$d" || continue
		json_get_var u up
		if [ "$u" != 1 ]; then json_select ..; return 1; fi
		if json_select ifnames; then
			json_get_keys n
			for i in $n; do
				json_select "$i" || continue
				json_get_var iname ifname
				json_select ..
				[ -n "$iname" ] || continue
				ip link show "$iname" 2>/dev/null | grep -q '<[^>]*UP' || bad=1
			done
			json_select ..
		fi
		json_select ..
	done
	[ "$bad" = 0 ] || return 1
}

# WiFi 恢复兜底（与 mt3600be-reset-control 同源）。
#
# 实测（GL-MT3600BE / mtwifi 闭源驱动）：
#  - "关 WiFi → 立刻开 WiFi" 时，5G radio 的 setup 会静默挂住 —— syslog 里
#    mtwifi-cfg 只有 "[Lock] Exclusive lock acquired!!!" 就没有下文，rai0 起不来；
#    但间隔一会儿再执行一次 `wifi reload`，5G 通常 3 秒内就恢复。
#  - 固件有时会把 wireless.<radio>.disabled 写回 '1' 并跨重启保留，
#    于是下一次快照会"忠实"记录这个坏值，自我强化成"永远只有一半 WiFi"。
#  - 因此兜底策略是：每次重试前重新套用快照 + `wifi reload`，做收敛式重试；
#    `wifi up` 与重启都只在重试全部失败后才作为最后手段。
HEAL_FLAG='/tmp/mt3600be-wifi-selfheal'

wifi_apply_state() {
	config_load mt3600be-toggle
	config_list_foreach wifi_state radio restore_radio
	config_list_foreach wifi_state iface restore_iface
	uci -q commit wireless
}

wifi_heal() {
	local i=0
	while [ "$i" -lt 5 ]; do
		sleep 6
		if wifi_all_vifs_up; then
			logger -t "$TAG" 'WiFi fully up'
			return 0
		fi
		i=$((i + 1))
		logger -t "$TAG" "WiFi restore incomplete, retry $i (wifi reload)"
		wifi_apply_state
		wifi reload >/dev/null 2>&1
	done
	sleep 8
	if wifi_all_vifs_up; then
		logger -t "$TAG" 'WiFi fully up after retries'
		return 0
	fi

	# 重试全部失败：再套一次快照（对抗 disabled 写回），然后才考虑一次性重启。
	wifi_apply_state
	logger -t "$TAG" 'WiFi still down after 5 reload retries'
	[ "$(uci -q get mt3600be-toggle.main.wifi_selfheal_reboot)" = 0 ] && { logger -t "$TAG" 'selfheal reboot disabled, giving up'; return 1; }
	[ -e "$HEAL_FLAG" ] && { logger -t "$TAG" 'selfheal reboot already used this boot'; return 1; }
	[ "$(cut -d. -f1 /proc/uptime | tr -d ' ')" -lt 300 ] && { logger -t "$TAG" 'uptime<300s, skip auto reboot'; return 1; }
	touch "$HEAL_FLAG"
	logger -t "$TAG" 'WiFi unrecoverable, one-shot recovery reboot in 60s'
	(
		sleep 60
		if wifi_all_vifs_up; then
			logger -t "$TAG" 'WiFi recovered before reboot, cancelled'
			rm -f "$HEAL_FLAG"
		else
			logger -t "$TAG" 'rebooting to restore radios'
			sync
			sleep 2
			reboot
		fi
	) &
	return 1
}

restore_radio() {
	local entry="$1" section value
	section="${entry%%=*}"
	value="${entry#*=}"
	sec_safe "$section" || return 0
	case "$(uci -q get "wireless.${section}" 2>/dev/null)" in
		wifi-device) ;;
		*) return 0;;
	esac
	case "$value" in 0|1) uci -q set "wireless.${section}.disabled=${value}";; esac
}

restore_iface() {
	local entry="$1" section value
	section="${entry%%=*}"
	value="${entry#*=}"
	sec_safe "$section" || return 0
	case "$(uci -q get "wireless.${section}" 2>/dev/null)" in
		wifi-iface) ;;
		*) return 0;;
	esac
	case "$value" in 0|1) uci -q set "wireless.${section}.disabled=${value}";; esac
}

case "$1" in
	snapshot)
		uci -q delete mt3600be-toggle.wifi_state
		uci -q set mt3600be-toggle.wifi_state='wifi_state'
		config_load wireless
		config_foreach snapshot_radio wifi-device
		config_foreach snapshot_iface wifi-iface
		uci -q commit mt3600be-toggle
		logger -t "$TAG" 'saved current WiFi radio/SSID states'
		;;
	off)
		TARGETS="$(wifi_target_list)"
		if [ -z "$TARGETS" ]; then
			# 总控：整机关无线（射频下电），与旧行为完全一致
			config_load wireless
			config_foreach disable_radio wifi-device
			wifi_reload
			logger -t "$TAG" 'WiFi disabled by switch (all radios)'
		else
			for sec in $TARGETS; do
				case "$(uci -q get "wireless.${sec}" 2>/dev/null)" in
					wifi-device|wifi-iface)
						uci -q set "wireless.${sec}.disabled=1" ;;
					*)
						logger -t "$TAG" "WiFi target skipped (unknown section): $sec" ;;
				esac
			done
			wifi_reload
			logger -t "$TAG" "WiFi disabled by switch: $TARGETS"
		fi
		;;
	restore)
		config_load mt3600be-toggle
		config_get state_type wifi_state TYPE ''
		[ "$state_type" = 'wifi_state' ] || {
			logger -t "$TAG" 'WiFi restore skipped: no saved state'
			exit 1
		}
		config_list_foreach wifi_state radio restore_radio
		config_list_foreach wifi_state iface restore_iface
		uci -q commit wireless
		wifi reload >/dev/null 2>&1
		wifi_heal
		logger -t "$TAG" 'restored saved WiFi radio/SSID states'
		;;
	*)
		echo "Usage: $0 {snapshot|off|restore}" >&2
		exit 2
		;;
esac
