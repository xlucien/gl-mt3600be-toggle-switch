#!/bin/sh

. /lib/functions.sh
. /usr/share/libubox/jshn.sh

TAG='mt3600be-reset'
STATE_DIR='/tmp/mt3600be-reset'
LOCK_DIR='/tmp/mt3600be-reset.lock'

delay_short() { /usr/libexec/mt3600be-delay 50; }
delay_window() { /usr/libexec/mt3600be-delay 1200; }
delay_pressed() { /usr/libexec/mt3600be-delay 200; }

lock() {
	local tries=0 owner
	while :; do
		if mkdir "$LOCK_DIR" 2>/dev/null; then
			echo "$$" > "$LOCK_DIR/pid"
			return 0
		fi
		owner="$(cat "$LOCK_DIR/pid" 2>/dev/null)"
		if [ -z "$owner" ] || ! kill -0 "$owner" 2>/dev/null; then
			rm -f "$LOCK_DIR/pid" 2>/dev/null; rmdir "$LOCK_DIR" 2>/dev/null
			continue
		fi
		tries=$((tries + 1)); [ "$tries" -lt 50 ] || return 1; delay_short
	done
}
unlock() {
	[ "$(cat "$LOCK_DIR/pid" 2>/dev/null)" = "$$" ] || return 0
	rm -f "$LOCK_DIR/pid"; rmdir "$LOCK_DIR" 2>/dev/null
}

clear_pending() {
	mkdir -p "$STATE_DIR"
	lock || return 1
	GEN="$(cat "$STATE_DIR/generation" 2>/dev/null)"; GEN=$((${GEN:-0} + 1))
	echo "$GEN" > "$STATE_DIR/generation"
	rm -f "$STATE_DIR/count" "$STATE_DIR/pressed" "$STATE_DIR/long"
	unlock
}

record_result() {
	printf 'gesture=%s\naction=%s\nresult=%s\ntime=%s\n' "$1" "$2" "$3" "$(date '+%Y-%m-%d %H:%M:%S')" > "$STATE_DIR/last"
}

wifi_snapshot() {
	uci -q delete mt3600be-toggle.reset_wifi_state
	uci -q set mt3600be-toggle.reset_wifi_state='wifi_state'
	uci -q set mt3600be-toggle.reset_wifi_state.pending='1'
	config_load wireless
	reset_save_radio() {
		local section="$1" disabled
		config_get disabled "$section" disabled '0'
		uci -q add_list "mt3600be-toggle.reset_wifi_state.radio=${section}=${disabled}"
	}
	config_foreach reset_save_radio wifi-device
	uci -q commit mt3600be-toggle
}

wifi_off() {
	config_load wireless
	reset_disable_radio() { uci -q set "wireless.$1.disabled=1"; }
	config_foreach reset_disable_radio wifi-device
	uci -q commit wireless
	wifi reload >/dev/null 2>&1
}

# 校验每个 wifi-device 的 vif 是否真的处于 UP。
# mtwifi-cfg 的 "Exclusive lock" 实际并不互斥：并发 setup 可能静默丢掉
# 其中一个 radio 的初始化，导致恢复后只剩一半 WiFi。
wifi_all_vifs_up() {
	local keys d n i u iname bad=0
	json_cleanup >/dev/null 2>&1
	json_load "$(ubus call network.wireless status 2>/dev/null)" || return 1
	json_get_keys keys || return 1
	[ -n "$keys" ] || return 1
	for d in $keys; do
		json_select "$d" || continue
		json_get_var u up
		if [ "$u" != 1 ]; then json_select ..; return 1; fi
		if json_select ifnames; then
			json_get_keys n
			for i in $n; do
				json_select "$i" || continue
				json_get_var iname ifname
				json_select ..
				[ -n "$iname" ] || continue
				ip link show "$iname" 2>/dev/null | grep -q '<[^>]*UP' || bad=1
			done
			json_select ..
		fi
		json_select ..
	done
	[ "$bad" = 0 ] || return 1
}

# WiFi 恢复兜底（与 mt3600be-toggle-wifi 同源）。
#
# 实测（GL-MT3600BE / mtwifi 闭源驱动）：
#  - "关 WiFi → 立刻开 WiFi" 时，5G radio 的 setup 会静默挂住 —— syslog 里
#    mtwifi-cfg 只有 "[Lock] Exclusive lock acquired!!!" 就没有下文，rai0 起不来；
#    但间隔一会儿再执行一次 `wifi reload`，5G 通常 3 秒内就恢复。
#  - 固件有时会把 wireless.<radio>.disabled 写回 '1' 并跨重启保留，
#    于是下一次快照会"忠实"记录这个坏值，自我强化成"永远只有一半 WiFi"。
#  - 因此兜底策略是：每次重试前重新套用快照 + `wifi reload`，做收敛式重试；
#    重启只在重试全部失败后作为最后手段。
HEAL_FLAG='/tmp/mt3600be-wifi-selfheal'

wifi_apply_state() {
	config_load mt3600be-toggle
	config_list_foreach reset_wifi_state radio reset_restore_radio
	uci -q commit wireless
}

wifi_heal() {
	local i=0
	while [ "$i" -lt 5 ]; do
		sleep 6
		if wifi_all_vifs_up; then
			logger -t "$TAG" 'wifi fully up'
			return 0
		fi
		i=$((i + 1))
		logger -t "$TAG" "wifi restore incomplete, retry $i (wifi reload)"
		wifi_apply_state
		wifi reload >/dev/null 2>&1
	done
	sleep 8
	if wifi_all_vifs_up; then
		logger -t "$TAG" 'wifi fully up after retries'
		return 0
	fi

	# 重试全部失败：再套一次快照（对抗 disabled 写回），然后才考虑一次性重启。
	wifi_apply_state
	logger -t "$TAG" 'wifi still down after 5 reload retries'
	[ "$(uci -q get mt3600be-toggle.main.wifi_selfheal_reboot)" = 0 ] && { logger -t "$TAG" 'selfheal reboot disabled, giving up'; return 1; }
	[ -e "$HEAL_FLAG" ] && { logger -t "$TAG" 'selfheal reboot already used this boot'; return 1; }
	[ "$(cut -d. -f1 /proc/uptime | tr -d ' ')" -lt 300 ] && { logger -t "$TAG" 'uptime<300s, skip auto reboot'; return 1; }
	touch "$HEAL_FLAG"
	logger -t "$TAG" 'wifi unrecoverable, one-shot recovery reboot in 60s'
	(
		sleep 60
		if wifi_all_vifs_up; then
			logger -t "$TAG" 'wifi recovered before reboot, cancelled'
			rm -f "$HEAL_FLAG"
		else
			logger -t "$TAG" 'rebooting to restore radios'
			sync
			sleep 2
			reboot
		fi
	) &
	return 1
}

reset_restore_radio() {
	local entry="$1" section disabled
	section="${entry%%=*}"
	disabled="${entry#*=}"
	case "$section" in ''|*[!A-Za-z0-9_]* ) return 0;; esac
	case "$disabled" in 0|1) uci -q set "wireless.${section}.disabled=${disabled}" && found=1;; esac
}

wifi_restore() {
	local pending
	found=0
	config_load mt3600be-toggle
	config_get pending reset_wifi_state pending '0'
	[ "$pending" = 1 ] || return 1
	config_list_foreach reset_wifi_state radio reset_restore_radio
	[ "$found" -eq 1 ] || return 1
	uci -q commit wireless
	wifi reload >/dev/null 2>&1
	wifi_heal
	uci -q delete mt3600be-toggle.reset_wifi_state
	uci -q commit mt3600be-toggle
}

wifi_toggle() {
	local any_enabled=0
	config_load wireless
	reset_check_radio() {
		local disabled
		config_get disabled "$1" disabled '0'
		[ "$disabled" = 1 ] || any_enabled=1
	}
	config_foreach reset_check_radio wifi-device
	if [ "$any_enabled" -eq 1 ]; then
		wifi_snapshot; wifi_off; echo wifi_off
	elif wifi_restore; then
		echo wifi_restored
	else
		echo no_wifi_snapshot; return 1
	fi
}

led_toggle() {
	local name path value max any=0
	name="$(uci -q get mt3600be-toggle.main.led_name)"; [ -n "$name" ] || name='white:status'
	for word in $name; do
		path="/sys/class/leds/$word"
		[ -r "$path/brightness" ] && [ -w "$path/brightness" ] || continue
		read -r value < "$path/brightness"
		[ -w "$path/trigger" ] && echo none > "$path/trigger"
		if [ "${value:-0}" -gt 0 ]; then
			echo 0 > "$path/brightness"; any=1
		else
			read -r max < "$path/max_brightness"; echo "${max:-1}" > "$path/brightness"; any=1
		fi
	done
	[ "$any" -eq 1 ] || return 1
	# Report by the state of the first controllable LED
	local first="${name%% *}"
	value=0
	[ -r "/sys/class/leds/$first/brightness" ] && read -r value < "/sys/class/leds/$first/brightness"
	[ "${value:-0}" -gt 0 ] && { echo led_on; return 0; } || { echo led_off; return 0; }
}

run_action() {
	local gesture="$1" enabled action result
	enabled="$(uci -q get mt3600be-toggle.main.reset_${gesture}_enabled)"
	action="$(uci -q get mt3600be-toggle.main.reset_${gesture}_action)"
	[ "$enabled" = 1 ] || { record_result "$gesture" "${action:-none}" disabled; logger -t "$TAG" "$gesture disabled"; return; }
	case "$action" in
		wifi) result="$(wifi_toggle)"; RC=$? ;;
		led) result="$(led_toggle)"; RC=$? ;;
		reboot)
			record_result "$gesture" reboot executing
			logger -t "$TAG" "$gesture: reboot"
			sync; reboot; return ;;
		*) result=invalid_action; RC=1 ;;
	esac
	[ "$RC" -eq 0 ] || result="${result:-failed}"
	record_result "$gesture" "$action" "$result"
	logger -t "$TAG" "$gesture: $action ($result)"
}

case "$1" in
	pressed)
		mkdir -p "$STATE_DIR"
		touch "$STATE_DIR/pressed"
		rm -f "$STATE_DIR/long"
		;;
	timeout)
		mkdir -p "$STATE_DIR"
		touch "$STATE_DIR/long"
		clear_pending
		touch "$STATE_DIR/long"
		. /etc/diag.sh
		set_state failsafe
		logger -t "$TAG" 'long press timeout reached'
		;;
	released)
		SEEN="${2:-0}"
		rm -f "$STATE_DIR/pressed"
		if [ "$SEEN" -ge 5 ] || [ -e "$STATE_DIR/long" ]; then
			clear_pending
			record_result long factory_reset executing
			logger -t "$TAG" 'long press: factory reset'
			factoryreset -y && reboot &
			exit 0
		fi
		lock || exit 1
		COUNT="$(cat "$STATE_DIR/count" 2>/dev/null)"; COUNT=$((${COUNT:-0} + 1))
		GEN="$(cat "$STATE_DIR/generation" 2>/dev/null)"; GEN=$((${GEN:-0} + 1))
		echo "$COUNT" > "$STATE_DIR/count"; echo "$GEN" > "$STATE_DIR/generation"
		unlock
		"$0" worker "$GEN" >/dev/null 2>&1 &
		;;
	worker)
		MY_GEN="$2"; delay_window
		while [ -e "$STATE_DIR/pressed" ]; do
			[ -e "$STATE_DIR/long" ] && exit 0
			delay_pressed
		done
		lock || exit 1
		GEN="$(cat "$STATE_DIR/generation" 2>/dev/null)"
		[ "$GEN" = "$MY_GEN" ] || { unlock; exit 0; }
		COUNT="$(cat "$STATE_DIR/count" 2>/dev/null)"
		rm -f "$STATE_DIR/count"; unlock
		case "$COUNT" in
			1) run_action single ;;
			2) run_action double ;;
			3) run_action triple ;;
			*) record_result "${COUNT:-0}_clicks" none unsupported; logger -t "$TAG" "unsupported click count: ${COUNT:-0}" ;;
		esac
		;;
	clear) clear_pending ;;
	status) cat "$STATE_DIR/last" 2>/dev/null ;;
	*) exit 2 ;;
esac
